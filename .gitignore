# Private profiles, generated restore state and credentials never belong in this repo.
.restore-*/
private/
secrets/
.env
.env.*
**/auth.json
**/credentials*
**/prayer-api.json
**/prayer-time-api*.txt
**/prayer-reminders.json
**/*.db
**/*.sqlite*
**/*.log
**/__pycache__/
**/node_modules/
**/*.before-*
**/.git/

# Shell histories and generated session/cache files remain private.
**/.zsh_history
**/.zsh_sessions/
**/.zcompdump*
**/.zsh-update
**/p10k-instant-prompt-*
